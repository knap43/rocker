<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A short tick when a gesture fires, so you know it landed with the phone in a pocket. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rocker"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- Launcher entries, one per icon; the in-app Appearance setting enables exactly one. -->
        <activity-alias
            android:name="com.knap43.rocker.LauncherClassic"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.knap43.rocker.LauncherColorful"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_colorful"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.knap43.rocker.LauncherSystem"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Does all the work: filters volume keys with the screen on, and hosts the
             screen-off media session. Android keeps an enabled accessibility service alive. -->
        <service
            android:name=".engine.RockerService"
            android:exported="false"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

    </application>
</manifest>
